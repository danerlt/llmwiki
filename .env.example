# === 数据库 / 队列 ===
DATABASE_URL=postgresql+asyncpg://llmwiki:llmwiki@postgres:5432/llmwiki
REDIS_URL=redis://redis:6379/0

# === 认证 ===
JWT_SECRET=change-me-in-prod          # REQUIRED：生产环境必须改成强随机值
JWT_EXPIRE_MIN=720

# === 对象存储 MinIO ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin           # REQUIRED：生产环境必须覆盖默认凭据
MINIO_SECRET_KEY=minioadmin           # REQUIRED：生产环境必须覆盖默认凭据
MINIO_BUCKET_SOURCES=sources
MINIO_BUCKET_ASSETS=assets
MINIO_SECURE=false

# === LLM（仅文本生成，OpenAI 兼容）===
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

APP_URL=http://localhost
